# Copia este archivo a .env para cambiar los valores. Si no existe .env,
# docker-compose.yml usa estos mismos valores por defecto (sólo para demo local).
# No uses estas credenciales fuera de tu máquina.

# PostgreSQL (el servicio "db" no publica ningún puerto al host)
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog_demo

# Puertos publicados en tu máquina
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Dirección interna del backend vista desde el contenedor del frontend.
# Se fija durante el build de la imagen del frontend (rewrite de /api).
BACKEND_INTERNAL_URL=http://backend:8080
